{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openadam.example/schemas/agent-host-state.schema.v0.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suiteVersion", "channel", "profile", "installedAt", "updatedAt", "components", "hosts", "runtime", "observability"],
  "properties": {
    "schemaVersion": { "const": "openadam.agent-host-state.v0.1" },
    "suiteVersion": { "type": "string", "minLength": 1 },
    "channel": { "enum": ["development", "release"] },
    "profile": { "type": "string", "minLength": 1 },
    "installedAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "releaseActivatedAt": { "type": "string", "format": "date-time" },
    "bindingsActivatedAt": { "type": "string", "format": "date-time" },
    "developmentRoot": { "type": "string", "minLength": 1 },
    "workspaceRoot": { "type": ["string", "null"], "minLength": 1 },
    "releaseId": { "type": "string", "minLength": 1 },
    "releaseManifest": { "type": "object" },
    "releaseSourceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "recordSha256", "remoteConfirmedAtBuildTime"],
      "properties": {
        "policy": { "enum": ["local-development", "local-clean", "remote-tagged"] },
        "recordSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "remoteConfirmedAtBuildTime": { "type": "boolean" }
      }
    },
    "components": { "type": "object" },
    "availableAgentComponents": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "agentComponents": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "componentWarmupVersion": { "const": 1 },
    "privateComponents": { "type": "object" },
    "hosts": { "type": "object" },
    "runtime": { "type": "object" },
    "observability": { "type": "object" },
    "rolledBackFrom": { "type": "string" }
  }
}
