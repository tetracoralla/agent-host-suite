{
  "schemaVersion": "openadam.procedure-studio-scenario.v0.1",
  "id": "covered-topic",
  "name": "Coverage already sufficient",
  "description": "Researcher, fact-checker, and editor each complete once and return the declared brief.",
  "inputs": {
    "goal": "Write a concise brief for local-first Procedure developers",
    "audience": "Procedure developers"
  },
  "grants": ["model.invoke", "network.read"],
  "resources": {},
  "limits": {
    "maxDurationMs": 60000,
    "maxNodeExecutions": 12,
    "maxAgentTurns": 8,
    "nodeTimeoutMs": 10000,
    "maxAttemptsPerNode": 4,
    "maxOutputBytes": 65536
  },
  "bindings": {
    "researcher": { "provider": "codex" },
    "fact-checker": { "provider": "grok" },
    "editor": { "provider": "zcode" }
  }
}
