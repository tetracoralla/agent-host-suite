{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openadam.dev/schemas/agent-host-release.schema.v0.2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseId", "suiteVersion", "status", "createdAt", "platforms", "components"],
  "properties": {
    "schemaVersion": { "const": "openadam.agent-host-release.v0.2" },
    "releaseId": { "type": "string", "minLength": 1 },
    "suiteVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "status": { "enum": ["draft-unbound", "internal-beta", "published"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "platforms": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["darwin-arm64", "darwin-x86_64"] } },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "platform", "artifact", "descriptorSha256", "license"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "version": { "type": "string", "minLength": 1 },
          "platform": { "enum": ["darwin-arm64", "darwin-x86_64"] },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "sha256", "bytes", "format"],
            "properties": {
              "url": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "bytes": { "type": "integer", "minimum": 1 },
              "format": { "const": "tar.gz" }
            }
          },
          "descriptorSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "license": {
            "type": "object",
            "additionalProperties": false,
            "required": ["spdx", "files"],
            "properties": {
              "spdx": { "type": "string", "minLength": 1 },
              "files": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    }
  }
}
