{
  "schemaVersion": "openadam.agent-host-github-tools.v0.1",
  "host": {
    "repository": "tetracoralla/agent-host-suite",
    "stableTagPrefix": "v",
    "catalogTag": "tool-catalog",
    "unsignedPreview": true
  },
  "tools": [
    {
      "id": "armorial",
      "repository": "tetracoralla/armorial",
      "featured": true,
      "assetName": "armorial-{version}-codex-plugin-{assetPlatform}.tar.gz",
      "checksumAssetName": "armorial-{version}-codex-plugin-{assetPlatform}.tar.gz.sha256",
      "platforms": {
        "darwin-arm64": "macos-arm64"
      }
    },
    {
      "id": "decision-table",
      "repository": "tetracoralla/decision-table",
      "featured": true,
      "source": {
        "kind": "repository-plugin",
        "pluginPath": "plugins/decision-table"
      }
    },
    {
      "id": "state-machine",
      "repository": "tetracoralla/state-machine",
      "featured": true,
      "source": {
        "kind": "repository-plugin",
        "pluginPath": "plugins/state-machine"
      }
    },
    {
      "id": "schedule-algebra",
      "repository": "tetracoralla/schedule-algebra",
      "featured": true,
      "source": {
        "kind": "repository-plugin",
        "pluginPath": "plugins/schedule-algebra"
      }
    }
  ]
}
