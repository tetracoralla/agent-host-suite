{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openadam.example/schemas/agent-host-profile.schema.v0.2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "components", "agentComponents"],
  "properties": {
    "schemaVersion": { "const": "openadam.agent-host-profile.v0.2" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "extends": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "agentComponents": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "defaultAgentComponents": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "requiresConsent": { "type": "boolean" }
  }
}
