{
  "schemaVersion": "openadam.agent-host-procedure-integration.v0.2",
  "displayName": "Research Brief",
  "summary": "Collect sources, check coverage, and write a brief for a named audience, pausing when an Agent needs one explicit clarification.",
  "procedure": {
    "id": "org.openadam.example.research-brief",
    "version": "1.0.0",
    "inputSchema": "input.schema.json",
    "outputSchema": "output.schema.json",
    "permissions": ["model.invoke", "network.read"],
    "resources": [],
    "lifecycle": {
      "mode": "stateful",
      "resumable": true,
      "interaction": "agent-mediated"
    }
  },
  "execution": {
    "kind": "agentic-runner",
    "method": "method.json",
    "outputArtifacts": ["brief"],
    "identityFiles": ["method.json"]
  },
  "ownership": {
    "uninstall": "agent-host-created-only"
  }
}
