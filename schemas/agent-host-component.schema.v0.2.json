{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openadam.dev/schemas/agent-host-component.schema.v0.2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "kind", "files", "identityFiles", "entrypoints", "integration", "legal"],
  "properties": {
    "schemaVersion": { "const": "openadam.agent-host-component.v0.2" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["node-runtime", "direct-runtime", "math-anchor", "migratory-time", "agent-tool-observer", "context-surface-analyzer", "agent-tool"] },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "executable"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "executable": { "type": "boolean" }
        }
      }
    },
    "identityFiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "entrypoints": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "integration": { "type": ["object", "null"] },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName", "summary"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 180 },
        "author": { "type": "string", "minLength": 1, "maxLength": 120 },
        "homepage": { "type": "string", "format": "uri" },
        "license": { "type": "string", "minLength": 1, "maxLength": 80 },
        "logo": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256", "bytes", "mediaType"],
          "properties": {
            "path": { "type": "string", "minLength": 1 },
            "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "bytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
            "mediaType": { "enum": ["image/png", "image/svg+xml", "image/jpeg", "image/webp"] }
          }
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["github-release", "catalog", "local-import", "github-repository"] },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "tag": { "type": "string", "minLength": 1 },
        "releaseUrl": { "type": "string", "format": "uri" },
        "assetUrl": { "type": "string", "format": "uri" },
        "assetName": { "type": "string", "minLength": 1 },
        "assetSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "assetBytes": { "type": "integer", "minimum": 1 },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "pluginPath": { "type": "string", "minLength": 1 }
      }
    },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license", "notice", "thirdPartyNotices", "sbom"],
      "properties": {
        "license": { "type": "string", "minLength": 1 },
        "notice": { "type": "string", "minLength": 1 },
        "thirdPartyNotices": { "type": "string", "minLength": 1 },
        "sbom": { "type": "string", "minLength": 1 }
      }
    }
  }
}
