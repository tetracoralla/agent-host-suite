{
  "name": "@openadam/agent-host-suite",
  "version": "0.1.1",
  "description": "Install and manage one compatible local environment for Agent tools.",
  "license": "Apache-2.0",
  "author": "openAdam",
  "homepage": "https://github.com/tetracoralla/agent-host-suite",
  "repository": {
    "type": "git",
    "url": "https://github.com/tetracoralla/agent-host-suite.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.16.0"
  },
  "os": [
    "darwin"
  ],
  "bin": {
    "agent-host": "bin/agent-host.mjs"
  },
  "files": [
    "bin/",
    "catalog/",
    "schemas/",
    "skills/",
    "src/",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.txt",
    "README.md"
  ],
  "scripts": {
    "build:app-icon": "scripts/build-app-icon.sh",
    "build:internal-beta-artifacts": "node scripts/build-internal-beta-artifacts.mjs",
    "check:internal-beta": "scripts/check-macos-distribution.sh internal-beta",
    "package:internal-beta": "scripts/package-internal-beta.sh",
    "probe:internal-beta-artifacts": "node scripts/probe-internal-beta-artifacts.mjs",
    "measure:local-dogfood": "node scripts/run-local-dogfood-cost-experiment.mjs",
    "measure:profile-catalogs": "node scripts/measure-profile-catalogs.mjs",
    "check": "npm run check:syntax && npm test && npm run check:repository && npm run check:package",
    "check:package": "node scripts/check-package.mjs",
    "check:repository": "node scripts/check-repository.mjs",
    "check:syntax": "node --check bin/agent-host.mjs && node scripts/check-syntax.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  }
}
