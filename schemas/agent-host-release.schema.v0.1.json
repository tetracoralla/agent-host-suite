{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openadam.example/schemas/agent-host-release.schema.v0.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suiteVersion", "status", "platforms", "components"],
  "properties": {
    "schemaVersion": { "const": "openadam.agent-host-release.v0.1" },
    "suiteVersion": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "status": { "enum": ["draft-unbound", "published"] },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["darwin-arm64", "darwin-x86_64", "linux-x86_64", "linux-arm64", "windows-x86_64"] }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "url", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "version": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        }
      }
    }
  }
}
