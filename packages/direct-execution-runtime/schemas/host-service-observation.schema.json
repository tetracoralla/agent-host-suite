{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openadam:direct-host-service-observation:v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "socketPath", "pid", "providerPreparation", "limits"],
  "properties": {
    "schemaVersion": { "const": "openadam.direct-host-service-observation.v0.2" },
    "status": { "const": "ready" },
    "socketPath": {
      "type": "string",
      "maxLength": 4096,
      "anyOf": [
        { "pattern": "^/" },
        { "pattern": "^\\\\{2}\\.\\\\pipe\\\\[^\\\\/]+$" }
      ]
    },
    "pid": { "type": "integer", "minimum": 1 },
    "providerPreparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "strategy", "providers", "totalMs"],
      "properties": {
        "status": { "enum": ["completed", "skipped"] },
        "strategy": { "enum": ["lazy", "sequential-persistent-providers"] },
        "providers": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["providerId", "sessionState", "generation", "observation", "durationMs"],
            "properties": {
              "providerId": { "type": "string", "minLength": 1, "maxLength": 200 },
              "sessionState": { "enum": ["cold", "warm"] },
              "generation": { "type": "integer", "minimum": 1 },
              "observation": { "enum": ["live_contract_observed", "process_started_unprobed"] },
              "durationMs": { "type": "number", "minimum": 0 }
            }
          }
        },
        "totalMs": { "type": "number", "minimum": 0 }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxConnections", "requestReceiveTimeoutMs", "maxWorkOrderBytes", "maxResultBytes"],
      "properties": {
        "maxConnections": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "requestReceiveTimeoutMs": { "type": "integer", "minimum": 10, "maximum": 60000 },
        "maxWorkOrderBytes": { "type": "integer", "minimum": 1024, "maximum": 16777216 },
        "maxResultBytes": { "type": "integer", "minimum": 262144, "maximum": 33554432 }
      }
    }
  }
}
