{
  "schemaVersion": "openadam.procedure-studio-scenario.v0.1",
  "id": "coverage-rework",
  "name": "Insufficient coverage returns to research",
  "description": "The fact-checker sends coverage back to the researcher once, then the Run completes with the declared brief.",
  "inputs": {
    "goal": "Compare two local research workflows",
    "audience": "Maintainers"
  },
  "grants": ["model.invoke", "network.read"],
  "resources": {},
  "limits": {
    "maxDurationMs": 60000,
    "maxNodeExecutions": 12,
    "maxAgentTurns": 8,
    "nodeTimeoutMs": 10000,
    "maxAttemptsPerNode": 4,
    "maxOutputBytes": 65536
  },
  "bindings": {
    "researcher": { "provider": "codex" },
    "fact-checker": { "provider": "grok" },
    "editor": { "provider": "zcode" }
  }
}
