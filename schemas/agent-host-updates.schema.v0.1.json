{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openadam.dev/schemas/agent-host-updates.schema.v0.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "generatedAt", "items", "preferences"],
  "properties": {
    "schemaVersion": { "const": "openadam.agent-host-updates.v0.1" },
    "status": { "enum": ["ok", "partial", "error"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "channel": { "enum": ["stable", "preview"] },
    "items": { "type": "array" },
    "preferences": { "type": "object" },
    "assessmentBoundary": { "type": "string" }
  }
}
