{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openadam.dev/schemas/agent-host-component.schema.v0.1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "kind", "files", "identityFiles", "entrypoints", "integration", "legal"],
  "properties": {
    "schemaVersion": { "const": "openadam.agent-host-component.v0.1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["node-runtime", "direct-runtime", "math-anchor", "migratory-time", "agent-tool-observer", "context-surface-analyzer", "agent-tool"] },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "bytes", "executable"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "bytes": { "type": "integer", "minimum": 0 },
          "executable": { "type": "boolean" }
        }
      }
    },
    "identityFiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "entrypoints": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "integration": { "type": ["object", "null"] },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["license", "notice", "thirdPartyNotices", "sbom"],
      "properties": {
        "license": { "type": "string", "minLength": 1 },
        "notice": { "type": "string", "minLength": 1 },
        "thirdPartyNotices": { "type": "string", "minLength": 1 },
        "sbom": { "type": "string", "minLength": 1 }
      }
    }
  }
}
