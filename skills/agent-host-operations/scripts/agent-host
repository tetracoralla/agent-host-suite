#!/bin/zsh
set -euo pipefail

run_module() {
  local module_path="$1"
  shift
  local node_path="${AGENT_HOST_NODE:-}"
  if [[ -z "${node_path}" ]]; then
    node_path="$(command -v node || true)"
  fi
  if [[ -z "${node_path}" || ! -x "${node_path}" ]]; then
    print -u2 "AGENT_HOST_NODE_UNAVAILABLE: Agent Host's Node runtime is unavailable."
    exit 127
  fi
  exec "${node_path}" "${module_path}" "$@"
}

if [[ -n "${AGENT_HOST_CLI:-}" ]]; then
  if [[ "${AGENT_HOST_CLI}" == *.mjs ]]; then
    run_module "${AGENT_HOST_CLI}" "$@"
  fi
  exec "${AGENT_HOST_CLI}" "$@"
fi

current_path="${0:A}"
command_path="$(command -v agent-host || true)"
if [[ -n "${command_path}" && "${command_path:A}" != "${current_path}" ]]; then
  exec "${command_path}" "$@"
fi

user_app="${HOME}/Applications/Agent Host.app"
for app_path in "/Applications/Agent Host.app" "${user_app}"; do
  launcher_path="${app_path}/Contents/MacOS/agent-host"
  if [[ -x "${launcher_path}" ]]; then
    exec "${launcher_path}" "$@"
  fi
  node_path="${app_path}/Contents/Resources/agent-host-runtime/node"
  cli_path="${app_path}/Contents/Resources/agent-host-suite/bin/agent-host.mjs"
  if [[ -x "${node_path}" && -f "${cli_path}" ]]; then
    exec "${node_path}" "${cli_path}" "$@"
  fi
done

print -u2 "AGENT_HOST_CLI_UNAVAILABLE: Install Agent Host.app or the published agent-host CLI."
exit 127
